rules_version = '2';

// Firestore aquí guarda LO MÁS SENSIBLE que existe en todo el proyecto: los refresh tokens con los
// que el backend puede actuar en el Drive de cada persona, y las sesiones abiertas.
//
// Por eso se deniega TODO acceso de cliente, sin excepciones y sin condiciones que revisar. El
// único que entra es el Admin SDK desde `api/auth`, que se salta las reglas por diseño y es
// precisamente lo que hace que la custodia sea del servidor y no del navegador.
//
// Si alguna vez hiciera falta que la app leyera algo de Firestore, NO se toca este bloque: se crea
// otra colección con su propia regla explícita. Ablandar esta sería regalar los refresh tokens.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
