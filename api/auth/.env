# Parámetros públicos de la función `auth`. VERSIONADO a propósito.
#
# `GOOGLE_OAUTH_CLIENT_ID` es un MARCADOR, no un valor: lo sustituye el workflow de despliegue por
# el `web.client_id` del secret `GOOGLE_OAUTH_CLIENT` del *environment*, sobre la copia que viaja en
# `deploy/dist/functions/auth/`. Aquí nunca se escribe un Client ID de verdad.
#
# Sin sufijo de proyecto (`.env`, no `.env.<projectId>`) a propósito: Firebase carga este fichero
# para CUALQUIER `--project`, así que el mismo artefacto sirve para todos los ambientes.
#
# El client secret NO está aquí ni puede estarlo: vive en Secret Manager (`defineSecret`), y en el
# emulador en `api/auth/.secret.local`. Ver deploy/README.md.

GOOGLE_OAUTH_CLIENT_ID=GOOGLE_OAUTH_CLIENT_ID
