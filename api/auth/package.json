{
  "name": "@clapastedyke/api-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente confidencial de OAuth: custodia el refresh token y emite tokens de acceso",
  "main": "lib/auth/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "tsc -p tsconfig.spec.json && node --test \"lib-test/**/*.spec.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "~6.0.2"
  }
}
