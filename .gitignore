# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Firebase — la CLI deja su caché y sus logs junto al firebase.json (deploy/)
.firebase/
firebase-debug.log
firebase-*-debug.log

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# System files
.DS_Store
Thumbs.db
/3dmodel/
/.notas/

*storybook.log
storybook-static
/documentation.json
/dist-dev/
/deploy/.env-secret

# Todo lo que sale de deploy/environments.json es GENERADO y no se versiona: la única verdad es ese
# fichero. Lo escriben deploy/wire-environment.sh (local) y deploy/build.sh (el artefacto).
/deploy/dist/
/deploy/proxy.config.json
/api/*/.env.*
/public/config.json
