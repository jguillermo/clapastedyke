{
  // Los tests se compilan APARTE y a otra carpeta (`lib-test/`, ignorada por git) para que no viajen
  // en el despliegue: `tsconfig.json` los excluye, y `lib/` solo lleva lo que se ejecuta en Cloud.
  //
  // No extiende `tsconfig.json` con `extends` porque necesita invertir su `exclude`, y en TypeScript
  // un `exclude` heredado no se puede "vaciar" sin volver a declararlo entero. Diez líneas duplicadas
  // cuestan menos que esa sutileza.
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib-test",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    // `lib` por encima del `target`: el emitido sigue siendo ES2017 (lo que espera el runtime), pero
    // los TIPOS incluyen ES2022 — que es de donde sale `new Error(msg, { cause })`, con el que
    // `GoogleOAuthError` conserva la traza original. Node 24 lo soporta de sobra en ejecución.
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "src"
  ]
}
