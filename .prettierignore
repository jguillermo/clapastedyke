# Artefactos de build y caché — no son fuente, no se formatean.
dist/
dist-dev/
out-tsc/
.angular/
node_modules/
storybook-static/
playwright-report/
test-results/
coverage/
documentation.json
package-lock.json

# Ficheros GENERADOS por deploy/wire-environment.sh y deploy/build.sh: los escribe un script desde
# deploy/environments.json, así que su formato no es cosa de Prettier.
public/config.json
deploy/proxy.config.json
api/*/.env.*

# La salida de `tsc` de cada función de `api/` (lo que se despliega). `lib-test/` es la de sus tests.
api/*/lib/
api/*/lib-test/

# Google Apps Script: `.gs` no es una extensión que Prettier entienda y el fichero se copia y pega
# tal cual en el editor de Apps Script (ver appscript.md).
apps-script/*.gs

# Snapshots y salidas generadas
__screenshots__/
*.log

# Documentación: las reglas de `.claude/` y los READMEs usan tablas y saltos pensados para leerse
# en GitHub; reformatearlos con Prettier no aporta nada y mete ruido en cada diff.
*.md

