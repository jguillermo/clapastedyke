# Artefactos de build y caché — no son fuente, no se formatean.
dist/
dist-dev/
out-tsc/
.angular/
node_modules/
storybook-static/
playwright-report/
test-results/
coverage/
documentation.json
package-lock.json

# Ficheros con MARCADORES que sustituye el pipeline de despliegue: su contenido no es cosa de
# Prettier, y reformatearlos rompería el `sed` que los sustituye.
public/config.json
firebase/functions/.env

# El artefacto de Hosting (lo escribe `ng build`) y la función, que tiene su propio ESLint
# (estilo Google: comillas dobles) y se pelearía con el Prettier del repo.
firebase/public/
firebase/functions/

# Google Apps Script: `.gs` no es una extensión que Prettier entienda y el fichero se copia y pega
# tal cual en el editor de Apps Script (ver appscript.md).
apps-script/*.gs

# Snapshots y salidas generadas
__screenshots__/
*.log

# Documentación: las reglas de `.claude/` y los READMEs usan tablas y saltos pensados para leerse
# en GitHub; reformatearlos con Prettier no aporta nada y mete ruido en cada diff.
*.md

